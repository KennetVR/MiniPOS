# Copy this file to mobile/.env and fill it locally. mobile/.env is Git-ignored.
# Use the project URL and the publishable (anon) key from the authorized Supabase project.
# That key is visible inside the app; Row Level Security and the RPCs are what protect the data.
# Never put a service_role key, a secret key, or a database password in this file or in any EXPO_PUBLIC_* variable.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key
